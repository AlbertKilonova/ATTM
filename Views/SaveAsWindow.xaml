<Window x:Class="ATTM.Views.SaveAsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存谱面"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Size.UI}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <StackPanel Margin="24,22,24,20">

        <TextBlock Text="文件名" Foreground="{DynamicResource Brush.TextSecondary}" />

        <TextBox x:Name="NameBox" Margin="0,8,0,0" Style="{StaticResource ThemedTextBox}"
                 TextChanged="NameBox_TextChanged" />

        <TextBlock Text="保存到" Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FolderBox" Style="{StaticResource ThemedTextBox}" IsReadOnly="True" />

            <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0"
                    Style="{StaticResource TextButton}" Click="Browse_Click" />
        </Grid>

        <Border Margin="0,18,0,0" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource Brush.SurfaceAlt}">
            <StackPanel>
                <TextBlock Text="会同时保存两个文件：" FontSize="{DynamicResource Size.UI.Small}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock x:Name="AttmPathText" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource Font.Editor}" FontSize="13" />
                <TextBlock x:Name="MidiPathText" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource Font.Editor}" FontSize="13"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Style="{StaticResource TextButton}" IsCancel="True" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>

    </StackPanel>
</Window>
