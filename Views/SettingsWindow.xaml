<Window x:Class="ATTM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="540"
        SizeToContent="Height"
        MinHeight="220"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Size.UI}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <StackPanel Margin="24,22,24,24">

        <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="主题" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" />

            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                      Style="{StaticResource ThemedComboBox}"
                      SelectionChanged="ThemeCombo_SelectionChanged">
                <ComboBoxItem Content="深色" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="跟随系统" />
            </ComboBox>
        </Grid>

        <TextBlock Text="播放" FontSize="15" FontWeight="SemiBold" Margin="0,26,0,0" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="MIDI 输出设备" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" />

            <ComboBox x:Name="DeviceCombo" Grid.Column="1"
                      Style="{StaticResource ThemedComboBox}"
                      SelectionChanged="DeviceCombo_SelectionChanged" />

            <Button Grid.Column="2" Content="刷新" Margin="8,0,0,0"
                    Style="{StaticResource TextButton}" Click="Refresh_Click" />
        </Grid>

    </StackPanel>
</Window>
