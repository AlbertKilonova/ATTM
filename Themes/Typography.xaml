<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 界面字体：中文优先微软雅黑，英文回退 Segoe UI -->
    <FontFamily x:Key="Font.UI">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>

    <!-- 编辑器字体：内置 Lekton，回退到等宽字体 -->
    <FontFamily x:Key="Font.Editor">pack://application:,,,/ATTM;component/assets/fonts/#Lekton, Consolas, Courier New</FontFamily>

    <!-- 图标字体：Material Symbols Sharp -->
    <FontFamily x:Key="Font.Icon">pack://application:,,,/ATTM;component/assets/fonts/#Material Symbols Sharp, Segoe UI Symbol</FontFamily>

    <sys:Double x:Key="Size.UI">13</sys:Double>
    <sys:Double x:Key="Size.UI.Small">11.5</sys:Double>
    <sys:Double x:Key="Size.Editor">15</sys:Double>
    <sys:Double x:Key="Size.Icon">20</sys:Double>
    <sys:Double x:Key="Size.Icon.Small">16</sys:Double>

</ResourceDictionary>
