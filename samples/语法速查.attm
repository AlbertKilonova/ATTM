# ATTM 语法速查
# 以 # 开头（# 后接空格）的行是注释

# 文件开头必须声明 bpm（可以带小数）和调式/拍号
bpm = 120
1 = C 4/4
# 可选：力度基准 1-127，随机抖动 +-n
Vel = 90 +-0

# ===== 基本音符 =====
# 数字 1-7 是高音谱号简谱，0 是休止
# 一行 = 一个小节，用逗号分段，段数必须是 1 / 2 / 4（4/4）
# 每段里的音符个数必须是 1 / 2 / 4 / 8 ...
1,2,3,4
1,2,3,4

# 0 会截断前一个音：这里 1 只响一拍
1,0,0,0

# ===== 八度与升号 =====
# + 升一个八度，- 降一个八度，# 升半音，必须紧贴数字
+1,-1,#4,+#4

# ===== 连奏 =====
# 音符会自动延长到下一个音符或小节末尾
1,2,3,4

# ===== 和弦 =====
(46+1),(357),(6+1+3),(46+1)

# ===== 并行小节（连续多行不空行）=====
1,2,3,4
5,6,7,+1
