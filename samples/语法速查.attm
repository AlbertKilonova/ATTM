# ATTM 语法速查
# 以 # 开头的行是注释（# 后面紧跟数字才是升号，例如 #4）
# 这份谱子可以直接播放，一边听一边对照左边的注释

# ===== 1. 三行指令（必须写在所有小节之前）=====
# bpm 速度：1-1000，可以带小数，例如 bpm = 92.5
bpm = 100
# 调式与拍号：根音 C-G，可带升号（1 = #F 4/4 或 1 = F# 4/4）；拍号只支持 4/4 和 3/4
1 = C 4/4
# 力度：基准 1-127，+-n 是每个音的随机抖动，可以省略
Vel = 90 +-6

# ===== 2. 音符与时值 =====
# 数字 1-7 是音级，0 是休止
# 一个音持续到本行下一个单元开始，最后一个音撑到小节末尾
1,2,3,4

# 0 会截断前一个音：这一小节里 1 只响一拍，后面三拍是空的
1,0,0,0

# 段内可以塞多个音，个数必须是 1、2、4、8……
# 下面四段分别是：两个八分 / 两个八分 / 一个四分 / 一个八分+休止
11,12,3,05

# 4/4 每行只能是 1、2、4 段（也就是 0、1、3 个逗号）；3/4 可以 1、2、3、4 段

# ===== 3. 八度与升号 =====
# + 升一个八度，- 降一个八度，可以叠加；# 升半音，必须紧贴数字
+1,-1,++1,--1

# 八度可以叠三层，八度写在升号前面
#4,+#4,+++#1,---#1

# ===== 4. 行前缀 $ 和 % =====
# $ 整行升一个八度（$$ 升两个），% 整行降一个八度
# 只能写在行首，后面必须跟一个空格，并且只影响这一行
$ 1,2,3,4
% 1,2,3,4

# ===== 5. 和弦 =====
# 括号里的音同时发声，整个括号算一个单元
(46+1),(357),(6+1+3),(46+1)

# ===== 6. 连奏 legato() =====
# 组内的音依次起音（不像和弦那样同时），但每个音的时值都撑到本段末尾
legato(1234)

# 括号里的拍位数（音符和休止符 0 都算）也必须是 1、2、4、8……
# 这一小节：1 在正拍、休止半拍、3 在第二拍后半，两个音都延音到小节末
legato(1020)

# legato 可以和 $ / % 连用，行前缀对整行生效（包括括号里的音）
$ legato(1357),0,5,1

# ===== 7. 并行声部 =====
# 连续几行不空行 = 同一个小节的多个声部，下面的旋律与和弦同时响
1,2,3,4
(135),(246),(357),(46+1)
